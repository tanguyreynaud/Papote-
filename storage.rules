rules_version = '2';
// Ancien bucket américain (papote-famille.firebasestorage.app) : plus utilisé depuis la bascule en Europe
// (config/base.bucket = papote-famille-eu). Fermé à toute appli (audit 8, N3). Les adresses de téléchargement avec
// jeton (captures de la galerie Validation) restent lisibles : elles ne passent pas par ces règles.
// Règles des familles : storage-eu.rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /{tout=**} {
      allow read, write: if false;
    }
  }
}

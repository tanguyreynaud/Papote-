rules_version = '2';

// Modèle :
//   invites/{code}                  -> { fid, createdBy, kind? }  code famille à 8 caractères ;
//                                      kind 'tablette' : code d'installation d'une tablette
//   families/{fid}                  -> { name, code, createdBy, createdAt, admins? }
//   families/{fid}/members/{uid}    -> { name, role, code, joinedAt, uid?, email?, status? }
//                                      status 'pending' : arrivé avec le code, en attente d'un responsable ;
//                                      absent ou 'active' : membre (les fiches d'avant n'ont pas de status)
//   families/{fid}/invitations/{email} -> { email, fid, familyName, invitedBy, createdAt }
//   families/{fid}/posts/{pid}      -> { type, text, image, authorUid, authorName, createdAt, seenAt, hearts }
//   (photo ou vidéo dans Storage : imageUrl ou videoUrl + storagePath families/{fid}/media/{id}.jpg|mp4|webm)
//   families/{fid}/birthdays/{bid}  -> { name, day, month, year|null, createdBy, createdAt }
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function familyPath(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }

    function memberPath(fid) {
      return /databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid);
    }

    // Membre actif : la fiche existe et n'est pas en attente de validation.
    function isMember(fid) {
      return signedIn()
        && exists(memberPath(fid))
        && get(memberPath(fid)).data.get('status', 'active') != 'pending';
    }

    // Connexion Google ou lien e-mail (pas un compte anonyme), adresse vérifiée.
    function isRealAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.get('email_verified', false) == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Abonnement (écrit par le serveur seulement) : champ absent ou statut offert, actif ou impayé
    // = tout fonctionne ; suspendu, résilié ou aucun = envois, agenda et appels bloqués.
    function abonnementOk(fid) {
      let abo = get(familyPath(fid)).data.get('abonnement', null);
      return abo == null || abo.get('statut', '') in ['offert', 'actif', 'impaye'];
    }

    // 30 proches au plus par famille (la tablette ne compte pas). nbProches est tenu à jour
    // côté serveur ; tant qu'il n'existe pas, aucune limite.
    function familleAPlace(fid) {
      return get(familyPath(fid)).data.get('nbProches', 0) < 30;
    }

    // Ville de la météo : { nom, lat?, lon? }.
    function villeMeteoOk(v) {
      return v is map && v.keys().hasAll(['nom']) && v.keys().hasOnly(['nom', 'lat', 'lon'])
        && v.nom is string && v.nom.size() > 0 && v.nom.size() <= 80
        && (!('lat' in v) || (v.lat is number && v.lat >= -90 && v.lat <= 90))
        && (!('lon' in v) || (v.lon is number && v.lon >= -180 && v.lon <= 180));
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    // Tableau de bord : seul l'administrateur voit toutes les familles.
    // Badge « admin » posé par outils/admin/badge-admin.bat.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('admin', false) == true;
    }

    // Mes familles : chaque fiche membre porte mon uid ; l'administrateur voit toutes les tablettes.
    match /{path=**}/members/{uid} {
      allow read: if isAdmin();
      allow read: if signedIn() && resource.data.get('uid', '') == request.auth.uid;
    }

    // Mes invitations : celles adressées à mon adresse e-mail vérifiée.
    match /{path=**}/invitations/{email} {
      allow read: if isRealAccount() && email == myEmail();
    }

    // Responsables de la famille : le créateur, plus ceux qu'il a désignés (champ admins).
    function isFamilyAdmin(fid) {
      let fam = get(familyPath(fid)).data;
      return isMember(fid)
        && (fam.createdBy == request.auth.uid || request.auth.uid in fam.get('admins', []));
    }

    function isCreatorAfter(fid) {
      return getAfter(familyPath(fid)).data.createdBy == request.auth.uid;
    }

    // Réglages communs (relais TURN des appels), écrits seulement depuis la console Firebase.
    // Jumelage d'une nouvelle tablette : elle affiche un code (et un QR code), un responsable
    // le réclame pour sa famille depuis l'app, puis la tablette confirme à l'écran.
    //   pairings/{code} -> { tabletUid, callsUid, name, createdAt, expiresAt, status,
    //                        fid?, familyName?, claimedBy?, claimedName? }
    match /pairings/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['tabletUid', 'callsUid', 'name', 'createdAt', 'expiresAt', 'status', 'serie'])
        // Numéro de série de la tablette (facultatif), pour la reconnaître dans l'espace admin.
        && (!('serie' in request.resource.data)
            || (request.resource.data.serie is string && request.resource.data.serie.size() <= 64))
        && request.resource.data.tabletUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(20, 'm');
      // Un responsable réclame la tablette pour sa famille, avant l'expiration du code.
      allow update: if isRealAccount()
        && resource.data.status == 'waiting'
        && request.time < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'fid', 'familyName', 'claimedBy', 'claimedName'])
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedBy == request.auth.uid
        && isFamilyAdmin(request.resource.data.fid);
      // La tablette accepte ou refuse la famille qui l'a réclamée.
      allow update: if signedIn()
        && request.auth.uid == resource.data.tabletUid
        && resource.data.status == 'claimed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['confirmed', 'refused'];
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.tabletUid || request.time > resource.data.expiresAt);
    }

    // Commandes reçues de Stripe (écrites par le serveur) : visibles de l'administrateur seulement.
    match /commandes/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /config/{name} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    match /invites/{code} {
      // Lecture d'un code connu uniquement : impossible de lister les familles.
      allow get: if signedIn();
      allow list: if false;
      // Code famille (à la création ou quand un responsable le change) ou code d'installation d'une tablette.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fid', 'createdBy', 'kind'])
        && request.resource.data.createdBy == request.auth.uid
        && (!('kind' in request.resource.data) || request.resource.data.kind == 'tablette')
        && (isCreatorAfter(request.resource.data.fid) || isFamilyAdmin(request.resource.data.fid)
          // Tablette de remplacement préparée par l'administrateur depuis le tableau de bord.
          || (isAdmin() && request.resource.data.kind == 'tablette'));
      allow update: if false;
      allow delete: if isFamilyAdmin(resource.data.fid);
      // Retrouver les codes d'une famille pour la supprimer (requête where fid == …).
      allow list: if isFamilyAdmin(resource.data.fid);
    }

    match /families/{fid} {
      allow get: if isMember(fid);
      allow list: if false;
      allow get, list: if isAdmin();
      allow create: if isRealAccount()
        && request.resource.data.keys().hasOnly(['name', 'code', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.code is string;
      allow update: if isMember(fid)
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && isFamilyAdmin(fid)
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 40)
          // Marqueur de changement : les tablettes ne relisent que lorsqu'il bouge.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rev'])
            && request.resource.data.rev is int)
          // Nouveau code famille, créé dans la même opération (l'ancien est effacé).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['code'])
            && isFamilyAdmin(fid)
            && getAfter(invitePath(request.resource.data.code)).data.fid == fid)
          // Mise en veille de la tablette la nuit : { active, de, a } (heures 0-23).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['veille', 'rev'])
            && isFamilyAdmin(fid)
            && request.resource.data.veille.keys().hasOnly(['active', 'de', 'a'])
            && request.resource.data.veille.active is bool
            && request.resource.data.veille.de is int && request.resource.data.veille.de >= 0 && request.resource.data.veille.de <= 23
            && request.resource.data.veille.a is int && request.resource.data.veille.a >= 0 && request.resource.data.veille.a <= 23)
          // Ville de la météo choisie par la famille (l'emporte sur celle de la tablette).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meteoVille', 'rev'])
            && isFamilyAdmin(fid)
            && villeMeteoOk(request.resource.data.meteoVille))
          // Options de la tablette : lecture à voix haute, réponse vocale, radio { active, nom, url }.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options', 'rev'])
            && isFamilyAdmin(fid)
            && request.resource.data.options is map
            && request.resource.data.options.keys().hasOnly(['lecture', 'reponseVocale', 'radio', 'sos', 'meteo', 'rappelsAccueil'])
            && (!('lecture' in request.resource.data.options) || request.resource.data.options.lecture is bool)
            && (!('meteo' in request.resource.data.options) || request.resource.data.options.meteo is bool)
            && (!('rappelsAccueil' in request.resource.data.options) || request.resource.data.options.rappelsAccueil is bool)
            && (!('sos' in request.resource.data.options) || request.resource.data.options.sos is bool)
            && (!('reponseVocale' in request.resource.data.options) || request.resource.data.options.reponseVocale is bool)
            && (!('radio' in request.resource.data.options)
                || (request.resource.data.options.radio is map
                    && request.resource.data.options.radio.keys().hasOnly(['active', 'nom', 'url', 'volume'])
                    && (!('volume' in request.resource.data.options.radio) || (request.resource.data.options.radio.volume is int && request.resource.data.options.radio.volume >= 5 && request.resource.data.options.radio.volume <= 100))
                    && request.resource.data.options.radio.active is bool
                    && (!('nom' in request.resource.data.options.radio) || (request.resource.data.options.radio.nom is string && request.resource.data.options.radio.nom.size() <= 60))
                    && (!('url' in request.resource.data.options.radio) || (request.resource.data.options.radio.url is string && request.resource.data.options.radio.url.size() <= 300 && request.resource.data.options.radio.url.matches('https://.*'))))))
          // Volume de la tablette (10 à 100), avec le compteur qui la prévient.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['volume', 'rev'])
            && isFamilyAdmin(fid)
            && request.resource.data.volume is int
            && request.resource.data.volume >= 10 && request.resource.data.volume <= 100)
          // Taille du texte sur la tablette, avec le compteur qui la prévient.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['textSize', 'rev'])
            && isFamilyAdmin(fid)
            && request.resource.data.textSize in ['normal', 'grande', 'tres-grande'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admins'])
            && isFamilyAdmin(fid)
            && request.resource.data.admins is list
            && request.resource.data.admins.size() <= 10)
        );
      // L'administrateur désigne le propriétaire d'une famille (secours depuis le tableau de bord).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdBy', 'admins']);

      // Supprimer la famille : par l'administrateur seulement, après échange avec le client.
      allow delete: if isAdmin();

      match /members/{uid} {
        // Jeton de notification du téléphone (appels de la tablette) : visible de soi seul.
        match /private/{name} {
          allow read, write: if signedIn() && uid == request.auth.uid;
        }
        allow read: if isMember(fid);
        // Un membre en attente ne voit que sa propre fiche.
        allow get: if signedIn() && uid == request.auth.uid;
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'role', 'code', 'joinedAt', 'canCall', 'uid', 'email', 'status', 'pairing'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && (
            // Tablette : avec un code d'installation de tablette, active d'office…
            (request.resource.data.role == 'tablette'
              && !('status' in request.resource.data)
              && !('pairing' in request.resource.data)
              && get(invitePath(request.resource.data.code)).data.get('kind', '') == 'tablette'
              && get(invitePath(request.resource.data.code)).data.fid == fid)
            // … ou par jumelage confirmé sur la tablette (ses deux comptes, dans l'heure qui suit).
            || (request.resource.data.role == 'tablette'
              && !('status' in request.resource.data)
              && !('code' in request.resource.data)
              && get(/databases/$(database)/documents/pairings/$(request.resource.data.pairing)).data.status == 'confirmed'
              && get(/databases/$(database)/documents/pairings/$(request.resource.data.pairing)).data.fid == fid
              && request.auth.uid in [
                get(/databases/$(database)/documents/pairings/$(request.resource.data.pairing)).data.tabletUid,
                get(/databases/$(database)/documents/pairings/$(request.resource.data.pairing)).data.callsUid]
              && request.time < get(/databases/$(database)/documents/pairings/$(request.resource.data.pairing)).data.expiresAt + duration.value(1, 'h'))
            // Famille : compte Google ou e-mail, avec son uid et son adresse.
            || (request.resource.data.role == 'famille'
              && familleAPlace(fid)
              && isRealAccount()
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.email == myEmail()
              && (
                // Créateur de la famille, ou invité par e-mail : actif tout de suite.
                ((isCreatorAfter(fid)
                    || exists(/databases/$(database)/documents/families/$(fid)/invitations/$(myEmail())))
                  && request.resource.data.status == 'active')
                // Arrivé avec le code famille : en attente d'un responsable.
                || (get(invitePath(request.resource.data.code)).data.fid == fid
                  && get(invitePath(request.resource.data.code)).data.get('kind', '') != 'tablette'
                  && request.resource.data.status == 'pending')
              ))
          );
        // L'administrateur accepte un membre en attente (secours depuis le tableau de bord).
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'active';
        // Un responsable accepte un membre en attente (s'il reste de la place).
        allow update: if isFamilyAdmin(fid)
          && familleAPlace(fid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'active';
        allow update: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'canCall', 'lastActive', 'lastOnline', 'callable', 'face', 'appVersion', 'uid', 'email', 'battery', 'sim', 'meteoVille', 'wifi', 'lastSeen'])
          // lastSeen : dernière fois que la caméra a vu quelqu'un (horodatage serveur).
          && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen == null || request.resource.data.lastSeen is timestamp)
          // Wi-Fi auquel la tablette est connectée : { ssid }.
          && (!('wifi' in request.resource.data) || request.resource.data.wifi == null
              || (request.resource.data.wifi is map && request.resource.data.wifi.keys().hasOnly(['ssid'])
                  && request.resource.data.wifi.ssid is string && request.resource.data.wifi.ssid.size() <= 64))
          // Ville de la météo utilisée par la tablette, affichée dans l'app.
          && (!('meteoVille' in request.resource.data) || request.resource.data.meteoVille == null
              || villeMeteoOk(request.resource.data.meteoVille))
          // uid et e-mail ajoutés aux fiches d'avant, pour retrouver ses familles.
          && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
          && (request.resource.data.get('email', null) == resource.data.get('email', null)
              || (isRealAccount() && request.resource.data.email == myEmail()))
          // Photo de profil : petite image JPEG en data URL, ou null pour la retirer.
          && (!('face' in request.resource.data) || request.resource.data.face == null
              || (request.resource.data.face is string && request.resource.data.face.size() <= 200000))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40;
        // Photo de la personne qui a la tablette : choisie par un responsable dans l'app.
        allow update: if isFamilyAdmin(fid)
          && resource.data.role == 'tablette'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['face'])
          && (request.resource.data.face == null
              || (request.resource.data.face is string && request.resource.data.face.size() <= 200000));
        // Quitter la famille : pas pour le propriétaire (personne ne pourrait le faire revenir).
        allow delete: if signedIn() && uid == request.auth.uid
          && get(familyPath(fid)).data.createdBy != request.auth.uid;
        // Ancienne tablette retirée par l'administrateur (remplacement).
        allow delete: if isAdmin() && resource.data.role == 'tablette';
        // L'administrateur retire un proche (secours), jamais le propriétaire.
        allow delete: if isAdmin() && resource.data.role == 'famille'
          && get(familyPath(fid)).data.createdBy != uid;
        // Un responsable peut retirer ou refuser un membre (la tablette seulement en supprimant la famille).
        allow delete: if isFamilyAdmin(fid);
      }

      // Invitations par e-mail : créées par un responsable, effacées par lui ou par l'invité qui a rejoint.
      match /invitations/{email} {
        allow read: if isFamilyAdmin(fid);
        allow create: if isFamilyAdmin(fid)
          && request.resource.data.keys().hasOnly(['email', 'fid', 'familyName', 'invitedBy', 'createdAt'])
          && email == email.lower()
          && request.resource.data.email == email
          && request.resource.data.fid == fid;
        allow delete: if isFamilyAdmin(fid) || (isRealAccount() && email == myEmail());
      }

      match /posts/{pid} {
        allow read: if isMember(fid);
        // Transfert des anciennes photos et vidéos vers Storage, depuis le tableau de bord.
        allow read, update: if isAdmin();
        allow create: if isMember(fid) && abonnementOk(fid)
          && request.resource.data.keys().hasOnly(['type', 'text', 'image', 'thumb', 'hasMedia', 'audio', 'duration', 'chunks', 'mime', 'replyTo', 'authorUid', 'authorName', 'createdAt', 'seenAt', 'hearts', 'imageUrl', 'videoUrl', 'storagePath', 'photos', 'audioUrl'])
          // Réponse vocale de la tablette : adresse du fichier son dans Storage.
          && (!('audioUrl' in request.resource.data) || (request.resource.data.audioUrl is string && request.resource.data.audioUrl.size() <= 1000))
          // Plusieurs photos dans un envoi : 5 au plus.
          && (!('photos' in request.resource.data) || (request.resource.data.photos is list && request.resource.data.photos.size() <= 5))
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.type in ['photo', 'message', 'voice', 'video', 'reply']
          && (!('audio' in request.resource.data) || request.resource.data.audio == null || request.resource.data.audio is string)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.image == null || request.resource.data.image is string)
          && request.resource.data.seenAt == null
          && request.resource.data.hearts == 0;
        // La tablette marque « vu » et envoie des bisous.
        allow update: if isMember(fid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt', 'hearts'])
          && request.resource.data.hearts is int
          && request.resource.data.hearts >= resource.data.hearts
          && request.resource.data.hearts <= resource.data.hearts + 1;
        // L'auteur supprime ses envois. Pour rester dans le quota gratuit, n'importe quel membre
        // peut aussi effacer un envoi de plus de 7 jours (nettoyage des plus anciennes photos et vidéos).
        allow delete: if isFamilyAdmin(fid);
        allow delete: if signedIn()
          && (resource.data.authorUid == request.auth.uid
              || (isMember(fid) && resource.data.createdAt < request.time - duration.value(7, 'd')));

        // Photo ou son en taille réelle, chargé seulement à la demande.
        match /media/{kind} {
          allow read: if isMember(fid);
          allow read, delete: if isAdmin();
          allow delete: if isFamilyAdmin(fid);
          allow create: if isMember(fid)
            && (kind in ['image', 'audio'] || kind.matches('video[0-9]+'))
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is string
            && getAfter(/databases/$(database)/documents/families/$(fid)/posts/$(pid)).data.authorUid == request.auth.uid;
          allow update: if false;
          allow delete: if signedIn()
            && (get(/databases/$(database)/documents/families/$(fid)/posts/$(pid)).data.authorUid == request.auth.uid
                || (isMember(fid)
                    && get(/databases/$(database)/documents/families/$(fid)/posts/$(pid)).data.createdAt < request.time - duration.value(7, 'd')));
        }
      }

      // Rappels et agenda : la famille les gère, la tablette note « c'est fait ».
      match /reminders/{rid} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid) && abonnementOk(fid)
          // lastSeen : « AAAA-MM-JJ HH:MM » quand un visage a regardé le rappel sur la tablette.
          && request.resource.data.keys().hasOnly(['title', 'kind', 'time', 'repeat', 'date', 'days', 'createdBy', 'createdAt', 'lastAck', 'lastSeen', 'avanceMin', 'finLe', 'enPauseJusquau'])
          // avanceMin : minutes d'annonce avant l'heure (absent = 15) ; finLe et enPauseJusquau : « AAAA-MM-JJ », jour compris.
          && (!('avanceMin' in request.resource.data) || request.resource.data.avanceMin == null
              || (request.resource.data.avanceMin is int && request.resource.data.avanceMin >= 0 && request.resource.data.avanceMin <= 240))
          && (!('finLe' in request.resource.data) || request.resource.data.finLe == null
              || (request.resource.data.finLe is string && request.resource.data.finLe.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (!('enPauseJusquau' in request.resource.data) || request.resource.data.enPauseJusquau == null
              || (request.resource.data.enPauseJusquau is string && request.resource.data.enPauseJusquau.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen == null
              || (request.resource.data.lastSeen is string && request.resource.data.lastSeen.size() <= 20))
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.kind in ['rdv', 'medicament', 'autre']
          && request.resource.data.repeat in ['once', 'daily', 'weekly']
          && request.resource.data.time is string;
        allow delete: if isMember(fid);
      }

      // Anniversaires de la famille : la tablette les rappelle le jour J.
      match /birthdays/{bid} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid) && abonnementOk(fid)
          && request.resource.data.keys().hasOnly(['name', 'day', 'month', 'year', 'createdBy', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.day is int
          && request.resource.data.day >= 1 && request.resource.data.day <= 31
          && request.resource.data.month is int
          && request.resource.data.month >= 1 && request.resource.data.month <= 12
          && (request.resource.data.year == null
              || (request.resource.data.year is int && request.resource.data.year >= 1900 && request.resource.data.year <= 2100));
        allow delete: if isMember(fid);
      }

      // Commandes à distance pour la tablette (responsables) : Wi-Fi, redémarrage, état.
      // La tablette les exécute, écrit le résultat et efface le mot de passe dans la même écriture.
      match /commands/{cid} {
        allow read: if isFamilyAdmin(fid) || (signedIn() && resource.data.target == request.auth.uid);
        allow create: if isFamilyAdmin(fid)
          && request.resource.data.keys().hasOnly(['type', 'target', 'createdBy', 'createdAt', 'ssid', 'security', 'password', 'state'])
          && request.resource.data.type in ['wifi', 'restart', 'status', 'wifiScan']
          && request.resource.data.target is string
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.state == 'pending'
          && (request.resource.data.type != 'wifi'
            || (request.resource.data.ssid is string && request.resource.data.ssid.size() > 0
              && request.resource.data.security in ['wpa2', 'wpa3', 'open']));
        allow update: if signedIn()
          && resource.data.target == request.auth.uid
          // reseaux : réponse à wifiScan, [{ ssid, security, signal }] (40 au plus).
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'result', 'doneAt', 'password', 'reseaux'])
          && (!('reseaux' in request.resource.data) || (request.resource.data.reseaux is list && request.resource.data.reseaux.size() <= 40))
          && !('password' in request.resource.data)
          && request.resource.data.state in ['done', 'failed'];
        allow delete: if isFamilyAdmin(fid);
      }

      // Journal d'erreurs de la tablette (200 dernières lignes), lisible des responsables.
      match /logs/{uid} {
        allow read: if isFamilyAdmin(fid);
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && isMember(fid)
          && request.resource.data.keys().hasOnly(['lines', 'version', 'updatedAt'])
          && request.resource.data.lines is string
          && request.resource.data.lines.size() <= 60000
          && request.resource.data.updatedAt == request.time;
      }

      // Appels vidéo : la famille appelle la tablette (signalisation WebRTC).
      match /calls/{cid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && abonnementOk(fid)
          && request.resource.data.keys().hasOnly(['callerUid', 'callerName', 'calleeUid', 'calleeName', 'state', 'offer', 'answer', 'createdAt', 'endedAt'])
          && request.resource.data.callerUid == request.auth.uid
          && request.resource.data.state == 'ringing';
        allow update: if isMember(fid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'answer', 'endedAt'])
          && request.resource.data.state in ['ringing', 'accepted', 'declined', 'missed', 'ended'];
        // La tablette écrit l'appel tout de suite (sans offre, pour que les téléphones sonnent plus
        // tôt), puis y ajoute son offre une seule fois.
        allow update: if isMember(fid)
          && resource.data.callerUid == request.auth.uid
          && resource.data.get('offer', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer'])
          && request.resource.data.offer.keys().hasOnly(['type', 'sdp'])
          && request.resource.data.offer.type == 'offer'
          && request.resource.data.offer.sdp is string;
        allow delete: if isFamilyAdmin(fid);

        match /{side}/{candidate} {
          allow read: if isMember(fid);
          allow create: if isMember(fid) && side in ['callerCandidates', 'calleeCandidates'];
          allow update: if false;
          allow delete: if isFamilyAdmin(fid);
        }
      }
    }
  }
}

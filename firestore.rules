rules_version = '2';

// Modèle :
//   invites/{code}                  -> { fid, createdBy }       code famille à 8 caractères
//   families/{fid}                  -> { name, code, createdBy, createdAt }
//   families/{fid}/members/{uid}    -> { name, role, code, joinedAt }
//   families/{fid}/posts/{pid}      -> { type, text, image, authorUid, authorName, createdAt, seenAt, hearts }
//   (photo ou vidéo dans Storage : imageUrl ou videoUrl + storagePath families/{fid}/media/{id}.jpg|mp4|webm)
//   families/{fid}/birthdays/{bid}  -> { name, day, month, year|null, createdBy, createdAt }
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function familyPath(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }

    function isMember(fid) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid));
    }

    function isCreatorAfter(fid) {
      return getAfter(familyPath(fid)).data.createdBy == request.auth.uid;
    }

    // Réglages communs (relais TURN des appels), écrits seulement depuis la console Firebase.
    match /config/{name} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    match /invites/{code} {
      // Lecture d'un code connu uniquement : impossible de lister les familles.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fid', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && isCreatorAfter(request.resource.data.fid);
      allow update, delete: if false;
    }

    match /families/{fid} {
      allow get: if isMember(fid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'code', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.code is string;
      allow update: if isMember(fid)
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 40)
          // Marqueur de changement : les tablettes ne relisent que lorsqu'il bouge.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rev'])
            && request.resource.data.rev is int)
        );
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(fid);
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'role', 'code', 'joinedAt', 'canCall'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.role in ['famille', 'tablette']
          && (isCreatorAfter(fid)
              || get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.fid == fid);
        allow update: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'canCall', 'lastActive', 'lastOnline', 'callable', 'face'])
          // Photo de profil : petite image JPEG en data URL, ou null pour la retirer.
          && (!('face' in request.resource.data) || request.resource.data.face == null
              || (request.resource.data.face is string && request.resource.data.face.size() <= 200000))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40;
        allow delete: if signedIn() && uid == request.auth.uid;
      }

      match /posts/{pid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid)
          && request.resource.data.keys().hasOnly(['type', 'text', 'image', 'thumb', 'hasMedia', 'audio', 'duration', 'chunks', 'mime', 'replyTo', 'authorUid', 'authorName', 'createdAt', 'seenAt', 'hearts', 'imageUrl', 'videoUrl', 'storagePath'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.type in ['photo', 'message', 'voice', 'video', 'reply']
          && (!('audio' in request.resource.data) || request.resource.data.audio == null || request.resource.data.audio is string)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.image == null || request.resource.data.image is string)
          && request.resource.data.seenAt == null
          && request.resource.data.hearts == 0;
        // La tablette marque « vu » et envoie des bisous.
        allow update: if isMember(fid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt', 'hearts'])
          && request.resource.data.hearts is int
          && request.resource.data.hearts >= resource.data.hearts
          && request.resource.data.hearts <= resource.data.hearts + 1;
        // L'auteur supprime ses envois. Pour rester dans le quota gratuit, n'importe quel membre
        // peut aussi effacer un envoi de plus de 7 jours (nettoyage des plus anciennes photos et vidéos).
        allow delete: if signedIn()
          && (resource.data.authorUid == request.auth.uid
              || (isMember(fid) && resource.data.createdAt < request.time - duration.value(7, 'd')));

        // Photo ou son en taille réelle, chargé seulement à la demande.
        match /media/{kind} {
          allow read: if isMember(fid);
          allow create: if isMember(fid)
            && (kind in ['image', 'audio'] || kind.matches('video[0-9]+'))
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is string
            && getAfter(/databases/$(database)/documents/families/$(fid)/posts/$(pid)).data.authorUid == request.auth.uid;
          allow update: if false;
          allow delete: if signedIn()
            && (get(/databases/$(database)/documents/families/$(fid)/posts/$(pid)).data.authorUid == request.auth.uid
                || (isMember(fid)
                    && get(/databases/$(database)/documents/families/$(fid)/posts/$(pid)).data.createdAt < request.time - duration.value(7, 'd')));
        }
      }

      // Rappels et agenda : la famille les gère, la tablette note « c'est fait ».
      match /reminders/{rid} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid)
          && request.resource.data.keys().hasOnly(['title', 'kind', 'time', 'repeat', 'date', 'days', 'createdBy', 'createdAt', 'lastAck'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.kind in ['rdv', 'medicament', 'autre']
          && request.resource.data.repeat in ['once', 'daily', 'weekly']
          && request.resource.data.time is string;
        allow delete: if isMember(fid);
      }

      // Anniversaires de la famille : la tablette les rappelle le jour J.
      match /birthdays/{bid} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid)
          && request.resource.data.keys().hasOnly(['name', 'day', 'month', 'year', 'createdBy', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.day is int
          && request.resource.data.day >= 1 && request.resource.data.day <= 31
          && request.resource.data.month is int
          && request.resource.data.month >= 1 && request.resource.data.month <= 12
          && (request.resource.data.year == null
              || (request.resource.data.year is int && request.resource.data.year >= 1900 && request.resource.data.year <= 2100));
        allow delete: if isMember(fid);
      }

      // Appels vidéo : la famille appelle la tablette (signalisation WebRTC).
      match /calls/{cid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid)
          && request.resource.data.keys().hasOnly(['callerUid', 'callerName', 'calleeUid', 'calleeName', 'state', 'offer', 'answer', 'createdAt', 'endedAt'])
          && request.resource.data.callerUid == request.auth.uid
          && request.resource.data.state == 'ringing';
        allow update: if isMember(fid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'answer', 'endedAt'])
          && request.resource.data.state in ['ringing', 'accepted', 'declined', 'missed', 'ended'];
        allow delete: if false;

        match /{side}/{candidate} {
          allow read: if isMember(fid);
          allow create: if isMember(fid) && side in ['callerCandidates', 'calleeCandidates'];
          allow update, delete: if false;
        }
      }
    }
  }
}

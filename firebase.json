{
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore-origine.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "europe",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "hosting": {
    "predeploy": [
      "node outils/web/version.mjs"
    ],
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.git/**",
      "**/.DS_Store"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "polices/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/.well-known/assetlinks.json",
        "destination": "/assetlinks.json"
      }
    ]
  },
  "auth": {
    "providers": {
      "anonymousAuth": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Papote",
        "supportEmail": "tanguyreynaud22@gmail.com"
      }
    }
  },
  "storage": [
    {
      "bucket": "papote-famille.firebasestorage.app",
      "rules": "storage.rules"
    },
    {
      "bucket": "papote-famille-eu",
      "rules": "storage-eu.rules"
    }
  ]
}

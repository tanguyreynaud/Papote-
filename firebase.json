{
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "europe",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.git/**",
      "**/.DS_Store"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/.well-known/assetlinks.json",
        "destination": "/assetlinks.json"
      }
    ]
  },
  "auth": {
    "providers": {
      "anonymousAuth": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Papote",
        "supportEmail": "tanguyreynaud22@gmail.com"
      }
    }
  },
  "storage": [
    {
      "bucket": "papote-famille.firebasestorage.app",
      "rules": "storage.rules"
    },
    {
      "bucket": "papote-famille-eu",
      "rules": "storage-eu.rules"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        "*.test.js"
      ]
    }
  ]
}

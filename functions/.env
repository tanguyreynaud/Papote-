# Adresse publique du site vitrine (retour après paiement). Pas de secret ici.
SITE_VITRINE=https://mapapote.fr
# Base Firestore « europe » (europe-west1), bucket Europe et région des déclencheurs. Voir base.js.
# Migration Europe du 2026-10-16 ; l'ancienne base (default) en nam5 → us-central1.
REGION_FIRESTORE=europe-west1
BASE_FIRESTORE=europe
BUCKET_STORAGE=papote-famille-eu
# E-mails aux clients (colis parti, rappels). Mot de passe : outils\mail\installer-mail.bat (secret).
# Brevo (domaine mapapote.fr). Identifiant SMTP public, la clé est un secret.
MAIL_SMTP=smtp-relay.brevo.com:587:9becee001@smtp-brevo.com
MAIL_EXPEDITEUR=contact@mapapote.fr
# Factures fournisseurs envoyées à factures@mapapote.fr (redirection OVH vers contact@), relevées toutes
# les heures par gestionCourrier. Mot de passe de la boîte : outils\gestion\installer-factures.bat (secret).
FACTURES_IMAP=ssl0.ovh.net:993:contact@mapapote.fr
FACTURES_ADRESSE=factures@mapapote.fr

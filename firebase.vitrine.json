{
  "hosting": {
    "site": "papote",
    "public": "vitrine",
    "ignore": ["README.md", "**/.*"],
    "rewrites": [
      { "source": "/", "function": { "functionId": "accueil", "region": "europe-west1" } },
      { "source": "/index.html", "function": { "functionId": "accueil", "region": "europe-west1" } },
      { "source": "/desinscription", "function": { "functionId": "desinscription", "region": "europe-west1" } }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/polices/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/desinscription.html",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
      },
      {
        "source": "/accueil.html",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
      }
    ]
  }
}

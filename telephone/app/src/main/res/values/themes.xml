<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Écran de démarrage (logo) avant l'app famille : barre des boutons Android gris léger avec des
         boutons foncés. Ensuite c'est Chrome qui dessine l'écran et sa barre, ce thème n'y joue plus. -->
    <style name="Papote.Ouverture" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:navigationBarColor">@color/barre_boutons</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <!-- Écran d'appel : crème dès la première image (plus de blanc avant la page). -->
    <style name="Papote.Appel" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/creme</item>
        <item name="android:statusBarColor">@color/creme</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/creme</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>

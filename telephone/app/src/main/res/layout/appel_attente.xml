<?xml version="1.0" encoding="utf-8"?>
<!-- Écran d'appel affiché dès le toucher, pendant que la page d'appel se charge derrière (13/11) :
     copie de l'écran crème de l'app famille (web/css/famille.css, .call.sonne) pour que la page
     prenne sa place sans que ça se voie. Jamais l'écran « Papote » qui charge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attente"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/creme"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="56dp"
    android:paddingEnd="24dp"
    android:paddingBottom="40dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:letterSpacing="0.08"
        android:text="@string/appel_video"
        android:textAllCaps="true"
        android:textColor="@color/indigo_doux"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/attente_initiale"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/carre_visage"
        android:elevation="6dp"
        android:gravity="center"
        android:textColor="@color/indigo"
        android:textSize="110sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/attente_nom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/indigo_fonce"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/appel_connexion"
        android:textColor="@color/indigo_doux"
        android:textSize="20sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/attente_raccrocher"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bouton_rouge"
        android:stateListAnimator="@null"
        android:text="@string/raccrocher"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/creme"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="56dp"
    android:paddingEnd="32dp"
    android:paddingBottom="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/appel_video"
        android:textColor="@color/indigo"
        android:textSize="18sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Visage : initiale dans un rond indigo, avec deux halos qui respirent pendant la sonnerie -->
    <FrameLayout
        android:layout_width="240dp"
        android:layout_height="240dp">

        <View
            android:id="@+id/halo1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rond_halo" />

        <View
            android:id="@+id/halo2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rond_halo" />

        <TextView
            android:id="@+id/initiale"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:background="@drawable/rond_indigo"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/nom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:textColor="@color/texte"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/vous_appelle_seul"
        android:textColor="@color/texte_doux"
        android:textSize="22sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/refuser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/rond_rouge"
                android:contentDescription="@string/refuser"
                android:padding="18dp"
                android:src="@drawable/ic_raccrocher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/refuser"
                android:textColor="@color/texte"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/repondre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/repondre_rond"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/rond_vert"
                android:contentDescription="@string/repondre"
                android:padding="18dp"
                android:src="@drawable/ic_notif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/repondre"
                android:textColor="@color/texte"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Autant de place sous les boutons qu'au-dessus : ils tombent sous le pouce, pas tout en bas. -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
